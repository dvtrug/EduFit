# Chỉ sao chép file này thành .env khi cần ghi đè cấu hình local mặc định.
POSTGRES_DB=edufit
POSTGRES_USER=edufit
POSTGRES_PASSWORD=thay-bang-mat-khau-local
POSTGRES_PORT=5433
BACKEND_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# =========================================================================
# Cấu hình AI Platform (Google Gemini / Stub)
# =========================================================================
# Lựa chọn: 'stub' (offline / test miễn phí) hoặc 'gemini' (gọi Google Gemini thật)
AI_PROVIDER=stub
# Khóa API Google Gemini (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =========================================================================
# Cấu hình Xác thực Google OAuth2 (Đăng nhập Google)
# =========================================================================
# Google Client ID (Lấy từ Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
