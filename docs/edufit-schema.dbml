// =====================================================================
// EduFit — Database schema (DBML for dbdiagram.io)
// NOTE: Primary Keys (PK) & Foreign Keys (FK) across business modules use UUID (generated by Java / DB default).
// NOTE: Lookup tables (education_level, subject) use INT.
// NOTE: table "class" == "Engagement" in the use case documents
//       (1 tutor + 1 student + 1 goal; NOT a group class).
// NOTE: table "account" holds all login accounts (Student/Parent/Tutor/Admin); column names keep the user_id / *_user_id form.
// NOTE: partial unique indexes / exclusion constraints are NOT drawable
//       here; see edufit-schema-review-changes.md section 5.
// =====================================================================

// ---------- ENUMS ----------
Enum user_role { STUDENT PARENT TUTOR ADMIN }
Enum account_status { ACTIVE DEACTIVATED }
Enum email_token_type { VERIFY_EMAIL RESET_PASSWORD }
Enum tutor_status { DRAFT UNVERIFIED PENDING_VERIFICATION VERIFIED }
Enum teaching_mode { ONLINE OFFLINE BOTH }
Enum goal_type { CONSOLIDATE IMPROVE_GRADES ADVANCED_STUDY EXAM_PREPARATION OTHER }
Enum goal_status { ACTIVE ARCHIVED }
Enum verification_status { PENDING APPROVED REJECTED }
Enum credential_type { DEGREE CERTIFICATE TEACHING_LICENCE STUDENT_CARD OTHER }
Enum invitation_status { PENDING ACCEPTED DECLINED WITHDRAWN EXPIRED }
Enum link_status { CONFIRMED REVOKED }
Enum request_status { PENDING ACCEPTED REJECTED CANCELLED EXPIRED }
Enum class_status { ACTIVE ENDED }
Enum session_status { PROPOSED SCHEDULED COMPLETED ABSENT CANCELLED REJECTED WITHDRAWN EXPIRED }
Enum session_mode { ONLINE OFFLINE }
Enum proposal_status { PENDING ACCEPTED REJECTED WITHDRAWN EXPIRED }
Enum cancel_reason { SCHEDULE_CONFLICT PERSONAL_REASON OTHER_PARTY_UNAVAILABLE OTHER }
Enum milestone_status { NOT_STARTED IN_PROGRESS ACHIEVED }
Enum reviewer_type { STUDENT PARENT }
Enum ai_feature { TUTOR_BIO MATCH_EXPLANATION }
Enum ai_status { SUCCESS ERROR TIMEOUT }

// =====================================================================
// MODULE: iam
// =====================================================================
Table account {
  user_id uuid [pk, default: `gen_random_uuid()`, note: 'UUID generated by Java/DB (NFR-03)']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'Argon2id (NFR-01)']
  full_name varchar(150) [not null]
  role user_role [not null, note: 'one role per account (BR-04)']
  status account_status [not null, default: 'ACTIVE', note: 'directly active upon registration']
  failed_attempts int [not null, default: 0, note: 'lock after 5 (NFR-05)']
  locked_until timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table email_token {
  token_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type email_token_type [not null]
  token_hash varchar(128) [not null, unique, note: 'SHA-256 hash (NFR-03)']
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// =====================================================================
// MODULE: profile
// =====================================================================
Table education_level {
  level_id int [pk, increment]
  name varchar(80) [not null, unique, note: 'e.g. Grade 6..12, University; Admin-managed']
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table subject {
  subject_id int [pk, increment]
  name varchar(100) [not null, unique]
  is_active boolean [not null, default: true]
}

Table student_profile {
  student_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, note: 'Student must have an account (BR-26)']
  education_level_id int
  area varchar(100) [note: 'coarse-grained only']
  profile_complete boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table tutor_profile {
  tutor_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  display_name varchar(100) [not null]
  headline varchar(200)
  bio text
  teaching_mode teaching_mode [not null]
  area varchar(100) [note: 'required when mode includes OFFLINE (BR-07)']
  price_per_session bigint [not null, note: 'VND']
  experience_years smallint
  teaching_method text
  status tutor_status [not null, default: 'DRAFT']
  verified_at timestamptz
  rating_avg decimal(3,2) [note: 'updated in same txn as review (FR-29)']
  review_count int [not null, default: 0]
  version int [not null, default: 0, note: 'optimistic lock (UC1.6.E2)']
  created_at timestamptz [not null, default: `now()`, note: 'tie-break BR-23']
  updated_at timestamptz [not null, default: `now()`]
}

Table tutor_subject {
  tutor_subject_id uuid [pk, default: `gen_random_uuid()`]
  tutor_id uuid [not null]
  subject_id int [not null]
  education_level_id int [not null]

  indexes {
    (tutor_id, subject_id, education_level_id) [unique]
  }
}

Table tutor_availability_slot {
  slot_id uuid [pk, default: `gen_random_uuid()`]
  tutor_id uuid [not null]
  day_of_week smallint [not null, note: '1=Mon..7=Sun']
  start_time time [not null]
  end_time time [not null]
}

Table learning_goal {
  goal_id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  subject_id int [not null]
  current_level smallint [not null, note: 'proficiency scale, ordered']
  desired_level smallint [not null, note: 'must be > current_level (BR-12)']
  goal_type goal_type [not null]
  deadline date [not null]
  mode teaching_mode [not null]
  area varchar(100)
  budget_min bigint
  budget_max bigint [not null]
  status goal_status [not null, default: 'ACTIVE', note: 'ARCHIVED if referenced (BR-12)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table goal_availability_slot {
  slot_id uuid [pk, default: `gen_random_uuid()`]
  goal_id uuid [not null]
  day_of_week smallint [not null]
  start_time time [not null]
  end_time time [not null]
}

// =====================================================================
// MODULE: verification
// =====================================================================
Table verification_request {
  request_id uuid [pk, default: `gen_random_uuid()`]
  tutor_id uuid [not null]
  status verification_status [not null, default: 'PENDING']
  rejection_reason text [note: 'required when REJECTED (BR-15)']
  submitted_at timestamptz [not null, default: `now()`]
  reviewed_by uuid
  reviewed_at timestamptz
}

Table credential {
  credential_id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null]
  type credential_type [not null]
  institution varchar(200) [not null]
  year smallint
  note varchar(500)
}

Table credential_file {
  file_id uuid [pk, default: `gen_random_uuid()`]
  credential_id uuid [not null]
  file_name varchar(255) [not null, note: 'sanitised (NFR-08)']
  storage_key varchar(500) [not null, note: 'path/key in CredentialStorageService']
  content_type varchar(100) [not null]
  size_bytes bigint [not null]
  uploaded_at timestamptz [not null, default: `now()`]
}

// =====================================================================
// MODULE: connection
// =====================================================================
Table link_invitation {
  invitation_id uuid [pk, default: `gen_random_uuid()`]
  inviter_user_id uuid [not null]
  invited_user_id uuid [not null]
  status invitation_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: '+14 days (BR-29)']
  responded_at timestamptz
  reinvite_after timestamptz [note: 'set on DECLINED, +7 days (BR-29)']
}

Table parent_student_link {
  link_id uuid [pk, default: `gen_random_uuid()`]
  parent_user_id uuid [not null]
  student_id uuid [not null]
  status link_status [not null, default: 'CONFIRMED']
  confirmed_at timestamptz [not null]
  revoked_at timestamptz
  revoked_by uuid [note: 'Student or Admin only (BR-30)']
  revoke_reason text [note: 'mandatory for Admin revoke']

  indexes {
    (parent_user_id, student_id) [unique]
  }
}

Table connection_request {
  request_id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  tutor_id uuid [not null]
  goal_id uuid [not null]
  sent_by_user_id uuid [not null, note: 'Student or linked Parent (BR-32)']
  desired_slots jsonb [note: 'weekly slots; may be split into a table later']
  message varchar(500)
  status request_status [not null, default: 'PENDING']
  reject_reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: '+7 days (BR-35)']
  responded_at timestamptz
}

Table class {
  class_id uuid [pk, default: `gen_random_uuid()`, note: '= Engagement in use case documents. 1 tutor + 1 student + 1 goal']
  connection_request_id uuid [not null, unique]
  student_id uuid [not null]
  tutor_id uuid [not null]
  goal_id uuid [not null]
  status class_status [not null, default: 'ACTIVE']
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  end_reason varchar(300)
}

// =====================================================================
// MODULE: scheduling
// =====================================================================
Table tutoring_session {
  session_id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null]
  tutor_id uuid [not null, note: 'denormalised from class, needed for exclusion constraint (NFR-17)']
  student_id uuid [not null, note: 'denormalised from class']
  start_at timestamptz [not null, note: 'UTC (NFR-18)']
  end_at timestamptz [not null, note: 'half-open [start,end) (BR-42)']
  mode session_mode [not null]
  place_or_link varchar(500)
  repeat_note varchar(300) [note: 'free text only (FR-22)']
  message varchar(500)
  status session_status [not null, default: 'PROPOSED']
  proposed_by uuid [not null]
  responded_by uuid
  responded_at timestamptz
  response_reason varchar(300)
  expires_at timestamptz [not null, note: 'min(+3 days, start_at) (BR-43)']
  cancelled_by uuid
  cancelled_at timestamptz
  cancel_reason cancel_reason
  cancel_comment varchar(300)
  is_late_cancel boolean [not null, default: false, note: '< 12h before start (BR-46)']
  outcome_recorded_by uuid [note: 'Tutor only (BR-47)']
  outcome_recorded_at timestamptz
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (class_id, status)
    (tutor_id, start_at)
    (student_id, start_at)
  }
}

Table session_reschedule_proposal {
  proposal_id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  proposed_by uuid [not null]
  new_start_at timestamptz [not null]
  new_end_at timestamptz [not null]
  reason varchar(300)
  status proposal_status [not null, default: 'PENDING']
  expires_at timestamptz [not null]
  responded_by uuid
  responded_at timestamptz
  response_reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
}

Table session_history {
  history_id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  reschedule_proposal_id uuid
  action varchar(40) [not null, note: 'CREATED, ACCEPTED, REJECTED, WITHDRAWN, EXPIRED, MOVED, CANCELLED, OUTCOME']
  actor_user_id uuid
  reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
}

// =====================================================================
// MODULE: progress
// =====================================================================
Table session_note {
  note_id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null, unique, note: 'one note per session, saved with the outcome (UC4.6)']
  tutor_id uuid [not null]
  note_text text [note: 'free text, max 5000, may be empty, not editable (BR-52)']
  created_at timestamptz [not null, default: `now()`]
}

Table learning_plan {
  plan_id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null, unique, note: 'one plan per class (BR-49)']
  summary varchar(1000)
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table milestone {
  milestone_id uuid [pk, default: `gen_random_uuid()`]
  plan_id uuid [not null]
  title varchar(200) [not null]
  description text
  target_date date
  weight smallint [not null, default: 1, note: '1..5 (BR-50)']
  status milestone_status [not null, default: 'NOT_STARTED']
  achieved_date date [note: 'not in the future']
  is_archived boolean [not null, default: false, note: 'excluded from progress (BR-51)']
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table plan_history {
  history_id uuid [pk, default: `gen_random_uuid()`]
  plan_id uuid [not null]
  milestone_id uuid
  action varchar(40) [not null, note: 'PLAN_CREATED, PLAN_EDITED, STATUS_CHANGED, REMOVED...']
  actor_user_id uuid [not null]
  old_value varchar(500)
  new_value varchar(500)
  created_at timestamptz [not null, default: `now()`, note: 'feeds progress-over-time (FR-24)']
}

// =====================================================================
// MODULE: review / notification
// =====================================================================
Table review {
  review_id uuid [pk, default: `gen_random_uuid()`]
  tutor_id uuid [not null]
  student_id uuid [not null]
  reviewer_user_id uuid [not null, note: 'author; only author can edit (BR-57)']
  reviewer_type reviewer_type [not null]
  rating smallint [not null, note: '1..5 (BR-58)']
  comment text [not null, note: '10..1000 chars']
  is_edited boolean [not null, default: false]
  completed_sessions_at_review int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tutor_id, student_id) [unique, note: 'one review per pair (NFR-24)']
  }
}

Table notification {
  notification_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'recipient']
  about_student_id uuid [note: 'lets Parent view be filtered by active link (BR-61)']
  type varchar(60) [not null]
  title varchar(200) [not null]
  short_text varchar(500) [not null, note: 'never holds note/review/credential text (BR-61)']
  target_type varchar(40)
  target_id uuid
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`, note: 'purge > 90 days (BR-62)']

  indexes {
    (user_id, is_read, created_at)
  }
}

// =====================================================================
// MODULE: platform (audit / ai) + discovery log
// =====================================================================
Table audit_log {
  audit_id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid [not null]
  action varchar(60) [not null, note: 'VERIFICATION_APPROVED, VERIFICATION_REJECTED, LINK_REVOKED_BY_ADMIN']
  target_type varchar(40) [not null]
  target_id uuid [not null]
  reason text
  created_at timestamptz [not null, default: `now()`]
}

Table ai_request_log {
  log_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  feature ai_feature [not null]
  status ai_status [not null]
  latency_ms int
  created_at timestamptz [not null, default: `now()`, note: 'no content stored (FR-05)']
}

Table matching_run_log {
  run_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  student_id uuid [not null]
  goal_id uuid [not null]
  result_count int [not null]
  created_at timestamptz [not null, default: `now()`, note: 'no criteria content (FR-10)']
}

// =====================================================================
// REFERENCES
// =====================================================================
// iam
Ref: email_token.user_id > account.user_id

// profile
Ref: student_profile.user_id - account.user_id
Ref: student_profile.education_level_id > education_level.level_id
Ref: tutor_profile.user_id - account.user_id
Ref: tutor_subject.tutor_id > tutor_profile.tutor_id
Ref: tutor_subject.subject_id > subject.subject_id
Ref: tutor_subject.education_level_id > education_level.level_id
Ref: tutor_availability_slot.tutor_id > tutor_profile.tutor_id
Ref: learning_goal.student_id > student_profile.student_id
Ref: learning_goal.subject_id > subject.subject_id
Ref: goal_availability_slot.goal_id > learning_goal.goal_id

// verification
Ref: verification_request.tutor_id > tutor_profile.tutor_id
Ref: verification_request.reviewed_by > account.user_id
Ref: credential.request_id > verification_request.request_id
Ref: credential_file.credential_id > credential.credential_id

// connection
Ref: link_invitation.inviter_user_id > account.user_id
Ref: link_invitation.invited_user_id > account.user_id
Ref: parent_student_link.parent_user_id > account.user_id
Ref: parent_student_link.student_id > student_profile.student_id
Ref: parent_student_link.revoked_by > account.user_id
Ref: connection_request.student_id > student_profile.student_id
Ref: connection_request.tutor_id > tutor_profile.tutor_id
Ref: connection_request.goal_id > learning_goal.goal_id
Ref: connection_request.sent_by_user_id > account.user_id
Ref: class.connection_request_id - connection_request.request_id
Ref: class.student_id > student_profile.student_id
Ref: class.tutor_id > tutor_profile.tutor_id
Ref: class.goal_id > learning_goal.goal_id

// scheduling
Ref: tutoring_session.class_id > class.class_id
Ref: tutoring_session.tutor_id > tutor_profile.tutor_id
Ref: tutoring_session.student_id > student_profile.student_id
Ref: tutoring_session.proposed_by > account.user_id
Ref: tutoring_session.responded_by > account.user_id
Ref: tutoring_session.cancelled_by > account.user_id
Ref: tutoring_session.outcome_recorded_by > account.user_id
Ref: session_reschedule_proposal.session_id > tutoring_session.session_id
Ref: session_reschedule_proposal.proposed_by > account.user_id
Ref: session_reschedule_proposal.responded_by > account.user_id
Ref: session_history.session_id > tutoring_session.session_id
Ref: session_history.reschedule_proposal_id > session_reschedule_proposal.proposal_id
Ref: session_history.actor_user_id > account.user_id

// progress
Ref: session_note.session_id - tutoring_session.session_id
Ref: session_note.tutor_id > tutor_profile.tutor_id
Ref: learning_plan.class_id - class.class_id
Ref: milestone.plan_id > learning_plan.plan_id
Ref: plan_history.plan_id > learning_plan.plan_id
Ref: plan_history.milestone_id > milestone.milestone_id
Ref: plan_history.actor_user_id > account.user_id

// review / notification
Ref: review.tutor_id > tutor_profile.tutor_id
Ref: review.student_id > student_profile.student_id
Ref: review.reviewer_user_id > account.user_id
Ref: notification.user_id > account.user_id
Ref: notification.about_student_id > student_profile.student_id

// platform
Ref: audit_log.actor_user_id > account.user_id
Ref: ai_request_log.user_id > account.user_id
Ref: matching_run_log.user_id > account.user_id
Ref: matching_run_log.student_id > student_profile.student_id
Ref: matching_run_log.goal_id > learning_goal.goal_id
